{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Sessions",
  "version": "0.2.1",
  "identifier": "local.agent-sessions.desktop",
  "build": {
    "frontendDist": "loader"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Agent Sessions",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 560,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/agent-sessions-server"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0NzdFQjNCRjBEODA0NTMKUldSVEJOandPK3QzWkNFekJ0L2lxdlArM3EvcWNadGdEUytIQ2doS2o5a3MzNFFzRmErL0ptVVIK",
      "endpoints": [
        "https://github.com/healwrap/agent-sessions-manager/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

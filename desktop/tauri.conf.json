{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Sessions",
  "version": "0.1.0",
  "identifier": "local.agent-sessions.desktop",
  "build": {
    "frontendDist": "loader"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Agent Sessions",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 560,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/agent-sessions-server"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}

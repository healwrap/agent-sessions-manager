{
  "name": "agent-sessions",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "desktop:build": "python3 tools/build_desktop.py",
    "dev": "vite --config frontend/vite.config.ts",
    "build:ui": "tsc --noEmit -p frontend/tsconfig.json && node tools/build_ui.mjs",
    "test:ui": "vitest run --config frontend/vite.config.ts",
    "test:backend": "python3 tools/test_backend.py",
    "test": "npm run check:size && npm run test:backend && npm run test:ui",
    "format": "prettier --write frontend/src frontend/vite.config.ts frontend/tsconfig.json tests/frontend",
    "format:check": "prettier --check frontend/src frontend/vite.config.ts frontend/tsconfig.json tests/frontend",
    "check:size": "python3 tools/check_code_size.py"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "lucide-react": "^1.49.0",
    "marked": "^17.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "type": "module"
}
